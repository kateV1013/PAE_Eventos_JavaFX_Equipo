<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: linear-gradient(to bottom right, #2f1b12, #6b3f25 45%, #d9c39d); -fx-font-family: 'Segoe UI', Arial;" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.ejercicio2.LoteController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" style="-fx-background-color: linear-gradient(to right, #2f1b12, #4f2d1d, #28543d); -fx-background-radius: 10; -fx-padding: 20 26 20 26; -fx-effect: dropshadow(gaussian, rgba(47, 27, 18, 0.42), 20, 0, 0, 8);">
            <Label text="&#x2615;" style="-fx-background-color: #f7e5bf; -fx-background-radius: 42; -fx-border-color: #a9783f; -fx-border-radius: 42; -fx-text-fill: #4f2d1d; -fx-font-size: 42px; -fx-padding: 10 14 10 14;"/>
            <VBox spacing="5.0">
                <Label text="Recepcion de cafe" style="-fx-text-fill: #fff8ec; -fx-font-size: 31px; -fx-font-weight: 700;"/>
                <Label text="Cooperativa cafetalera | Registro de lotes entregados por productores" style="-fx-text-fill: #d7e7c4; -fx-font-size: 14px;"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="16.0" style="-fx-padding: 20 0 0 0;">
                    <HBox spacing="14.0">
                        <VBox spacing="4.0" prefWidth="210.0" style="-fx-background-color: #f9ead1; -fx-background-radius: 10; -fx-border-color: #b8884f; -fx-border-radius: 10; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(47, 27, 18, 0.16), 10, 0, 0, 4);">
                            <Label text="Lotes de hoy" style="-fx-text-fill: #7a5638; -fx-font-size: 12px;"/>
                            <Label fx:id="lblLotesHoy" text="0" style="-fx-text-fill: #28543d; -fx-font-size: 28px; -fx-font-weight: 700;"/>
                        </VBox>
                        <VBox spacing="4.0" prefWidth="210.0" style="-fx-background-color: #f9ead1; -fx-background-radius: 10; -fx-border-color: #b8884f; -fx-border-radius: 10; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(47, 27, 18, 0.16), 10, 0, 0, 4);">
                            <Label text="Quintales recibidos" style="-fx-text-fill: #7a5638; -fx-font-size: 12px;"/>
                            <Label fx:id="lblQuintales" text="0.0" style="-fx-text-fill: #28543d; -fx-font-size: 28px; -fx-font-weight: 700;"/>
                        </VBox>
                        <VBox spacing="4.0" prefWidth="210.0" style="-fx-background-color: linear-gradient(to bottom right, #d7e7c4, #8aa66d); -fx-background-radius: 10; -fx-border-color: #52734d; -fx-border-radius: 10; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(47, 27, 18, 0.18), 10, 0, 0, 4);">
                            <Label text="Estado" style="-fx-text-fill: #3f5e3d; -fx-font-size: 12px;"/>
                            <Label text="Recepcion activa" style="-fx-text-fill: #2f1b12; -fx-font-size: 18px; -fx-font-weight: 700;"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="12.0" style="-fx-background-color: #f9ead1; -fx-background-radius: 10; -fx-border-color: #b8884f; -fx-border-radius: 10; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(47, 27, 18, 0.14), 12, 0, 0, 5);">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label text="Nuevo lote recibido" style="-fx-text-fill: #2f1b12; -fx-font-size: 18px; -fx-font-weight: 700;"/>
                                <Label text="Datos que se toman al momento de pesar y registrar el cafe." style="-fx-text-fill: #7a5638; -fx-font-size: 12px;"/>
                            </VBox>
                            <Label text="Area de bascula" style="-fx-background-color: #28543d; -fx-background-radius: 20; -fx-text-fill: #f9ead1; -fx-font-weight: 700; -fx-padding: 7 14 7 14;"/>
                        </HBox>

                        <GridPane hgap="14.0" vgap="10.0">
                            <Label text="Codigo de lote" style="-fx-text-fill: #4f2d1d; -fx-font-size: 12px; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label text="Productor" style="-fx-text-fill: #4f2d1d; -fx-font-size: 12px; -fx-font-weight: 700;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Variedad" style="-fx-text-fill: #4f2d1d; -fx-font-size: 12px; -fx-font-weight: 700;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                            <TextField fx:id="txtCodigo" promptText="Ej. L-005" prefWidth="190.0" style="-fx-background-color: #fffaf1; -fx-background-radius: 7; -fx-border-color: #a9783f; -fx-border-radius: 7; -fx-padding: 9; -fx-text-fill: #2f1b12;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <TextField fx:id="txtProductor" promptText="Nombre del productor" prefWidth="250.0" style="-fx-background-color: #fffaf1; -fx-background-radius: 7; -fx-border-color: #a9783f; -fx-border-radius: 7; -fx-padding: 9; -fx-text-fill: #2f1b12;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="cbVariedad" prefWidth="230.0" promptText="Seleccione tipo de cafe" style="-fx-background-color: #fffaf1; -fx-background-radius: 7; -fx-border-color: #a9783f; -fx-border-radius: 7; -fx-padding: 4; -fx-text-fill: #2f1b12;" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Arabica"/>
                                        <String fx:value="Robusta"/>
                                        <String fx:value="Caturra"/>
                                        <String fx:value="Bourbon"/>
                                        <String fx:value="Catimor"/>
                                        <String fx:value="Geisha"/>
                                        <String fx:value="Maragogipe"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>

                            <Label text="Peso del cafe" style="-fx-text-fill: #4f2d1d; -fx-font-size: 12px; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label text="Fecha de entrega" style="-fx-text-fill: #4f2d1d; -fx-font-size: 12px; -fx-font-weight: 700;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <Label text="Estado del lote" style="-fx-text-fill: #4f2d1d; -fx-font-size: 12px; -fx-font-weight: 700;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>

                            <TextField fx:id="txtPeso" promptText="Peso en quintales" prefWidth="190.0" style="-fx-background-color: #fffaf1; -fx-background-radius: 7; -fx-border-color: #a9783f; -fx-border-radius: 7; -fx-padding: 9; -fx-text-fill: #2f1b12;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <DatePicker fx:id="dpFechaEntrega" prefWidth="250.0" style="-fx-background-color: #fffaf1; -fx-background-radius: 7; -fx-border-color: #a9783f; -fx-border-radius: 7;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                            <ComboBox fx:id="cbEstado" prefWidth="230.0" promptText="Seleccione estado" style="-fx-background-color: #fffaf1; -fx-background-radius: 7; -fx-border-color: #a9783f; -fx-border-radius: 7; -fx-padding: 4; -fx-text-fill: #2f1b12;" GridPane.columnIndex="2" GridPane.rowIndex="3">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Recibido"/>
                                        <String fx:value="En revision"/>
                                        <String fx:value="Aceptado"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>

                            <Label text="Observaciones" style="-fx-text-fill: #4f2d1d; -fx-font-size: 12px; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <TextArea fx:id="txtObservaciones" promptText="Estado del grano, sacos recibidos o notas de calidad" prefHeight="58.0" style="-fx-background-color: #fffaf1; -fx-background-radius: 7; -fx-border-color: #a9783f; -fx-border-radius: 7; -fx-text-fill: #2f1b12;" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2"/>
                            <Button fx:id="btnRegistrar" text="Registrar lote" onAction="#registrarLote" prefWidth="230.0" style="-fx-background-color: linear-gradient(to right, #28543d, #52734d); -fx-background-radius: 7; -fx-text-fill: #fffaf1; -fx-font-weight: 700; -fx-padding: 12 16 12 16; -fx-cursor: hand;" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
                        </GridPane>
                    </VBox>

                    <VBox spacing="10.0" style="-fx-background-color: #f9ead1; -fx-background-radius: 10; -fx-border-color: #b8884f; -fx-border-radius: 10; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(47, 27, 18, 0.14), 12, 0, 0, 5);">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label text="Lotes registrados" style="-fx-text-fill: #2f1b12; -fx-font-size: 17px; -fx-font-weight: 700;"/>
                                <Label text="Historial visual de entregas recibidas por la cooperativa." style="-fx-text-fill: #7a5638; -fx-font-size: 12px;"/>
                            </VBox>
                            <Button text="Editar lote" onAction="#editarLote" style="-fx-background-color: linear-gradient(to right, #28543d, #52734d); -fx-background-radius: 7; -fx-text-fill: #fffaf1; -fx-font-weight: 700; -fx-padding: 9 16 9 16; -fx-cursor: hand;"/>
                            <Button text="Eliminar lote" onAction="#eliminarLote" style="-fx-background-color: #ead0bc; -fx-background-radius: 7; -fx-border-color: #8b4a32; -fx-border-radius: 7; -fx-text-fill: #7b2516; -fx-font-weight: 700; -fx-padding: 9 16 9 16; -fx-cursor: hand;"/>
                        </HBox>

                        <TableView fx:id="tablaLotes" onMouseClicked="#mostrarDetalle" prefHeight="210.0" style="-fx-background-color: #fffaf1; -fx-border-color: #a9783f; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <columns>
                                <TableColumn fx:id="colCodigo" prefWidth="120.0" text="Codigo lote" style="-fx-alignment: CENTER_LEFT;"/>
                                <TableColumn fx:id="colProductor" prefWidth="210.0" text="Productor" style="-fx-alignment: CENTER_LEFT;"/>
                                <TableColumn fx:id="colVariedad" prefWidth="150.0" text="Variedad" style="-fx-alignment: CENTER_LEFT;"/>
                                <TableColumn fx:id="colPeso" prefWidth="130.0" text="Peso" style="-fx-alignment: CENTER_LEFT;"/>
                                <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" style="-fx-alignment: CENTER_LEFT;"/>
                            </columns>
                            <placeholder>
                                <Label text="Aun no hay lotes registrados" style="-fx-text-fill: #7a5638; -fx-font-size: 14px;"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                    <GridPane hgap="16.0" vgap="10.0" style="-fx-background-color: #f9ead1; -fx-background-radius: 10; -fx-border-color: #b8884f; -fx-border-radius: 10; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(47, 27, 18, 0.14), 12, 0, 0, 5);">
                        <Label text="Detalles del lote seleccionado" style="-fx-text-fill: #2f1b12; -fx-font-size: 17px; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"/>
                        <Label text="Codigo" style="-fx-text-fill: #7a5638; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label text="Productor" style="-fx-text-fill: #7a5638; -fx-font-size: 12px;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label fx:id="lblDetalleCodigo" text="--" style="-fx-text-fill: #28543d; -fx-font-size: 16px; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="lblDetalleProductor" text="--" style="-fx-text-fill: #28543d; -fx-font-size: 16px; -fx-font-weight: 700;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Variedad" style="-fx-text-fill: #7a5638; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label text="Quintales" style="-fx-text-fill: #7a5638; -fx-font-size: 12px;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label fx:id="lblDetalleVariedad" text="--" style="-fx-text-fill: #28543d; -fx-font-size: 16px; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <Label fx:id="lblDetallePeso" text="--" style="-fx-text-fill: #28543d; -fx-font-size: 16px; -fx-font-weight: 700;" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>
</BorderPane>
