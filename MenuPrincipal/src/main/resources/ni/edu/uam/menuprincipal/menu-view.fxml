<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="24.0" style="-fx-background-color: linear-gradient(to bottom right, #1f3428, #704326, #ead7b8); -fx-font-family: 'Segoe UI', Arial;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.menuprincipal.MenuController">
    <padding>
        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0"/>
    </padding>

    <VBox alignment="CENTER" spacing="8.0" style="-fx-background-color: linear-gradient(to right, #2b1a12, #4f2f1d, #2f5a42); -fx-background-radius: 14; -fx-border-color: #c9a063; -fx-border-radius: 14; -fx-padding: 28 44 28 44; -fx-effect: dropshadow(gaussian, rgba(31, 20, 14, 0.35), 18, 0, 0, 7);">
        <Label style="-fx-text-fill: #fff8ec; -fx-font-size: 31px; -fx-font-weight: 700;" text="Menu de Programas"/>
        <Label style="-fx-text-fill: #dceccb; -fx-font-size: 15px;" text="Seleccione el programa que desea utilizar"/>
    </VBox>

    <HBox alignment="CENTER" spacing="18.0">
        <VBox alignment="CENTER" prefWidth="215.0" spacing="12.0" style="-fx-background-color: #fff4dd; -fx-background-radius: 12; -fx-border-color: #b98245; -fx-border-radius: 12; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(47, 27, 18, 0.18), 12, 0, 0, 5);">
            <Label alignment="CENTER" maxWidth="175.0" textAlignment="CENTER" wrapText="true" style="-fx-text-fill: #2b1a12; -fx-font-size: 18px; -fx-font-weight: 700;" text="Inventario de pulperia"/>
            <Label style="-fx-text-fill: #2f5a42; -fx-font-size: 13px; -fx-font-weight: 700;" text="Primer programa"/>
            <Button onAction="#abrirEjercicio1" prefWidth="140.0" style="-fx-background-color: linear-gradient(to right, #2f5a42, #5f7f4d); -fx-background-radius: 8; -fx-text-fill: #fffaf1; -fx-font-weight: 700; -fx-padding: 9 16 9 16;" text="Abrir"/>
        </VBox>

        <VBox alignment="CENTER" prefWidth="215.0" spacing="12.0" style="-fx-background-color: #fff4dd; -fx-background-radius: 12; -fx-border-color: #b98245; -fx-border-radius: 12; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(47, 27, 18, 0.18), 12, 0, 0, 5);">
            <Label alignment="CENTER" maxWidth="175.0" textAlignment="CENTER" wrapText="true" style="-fx-text-fill: #2b1a12; -fx-font-size: 18px; -fx-font-weight: 700;" text="Recepcion de cafe"/>
            <Label style="-fx-text-fill: #2f5a42; -fx-font-size: 13px; -fx-font-weight: 700;" text="Segundo programa"/>
            <Button onAction="#abrirEjercicio2" prefWidth="140.0" style="-fx-background-color: linear-gradient(to right, #2f5a42, #5f7f4d); -fx-background-radius: 8; -fx-text-fill: #fffaf1; -fx-font-weight: 700; -fx-padding: 9 16 9 16;" text="Abrir"/>
        </VBox>

        <VBox alignment="CENTER" prefWidth="215.0" spacing="12.0" style="-fx-background-color: #fff4dd; -fx-background-radius: 12; -fx-border-color: #b98245; -fx-border-radius: 12; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(47, 27, 18, 0.18), 12, 0, 0, 5);">
            <Label alignment="CENTER" maxWidth="175.0" textAlignment="CENTER" wrapText="true" style="-fx-text-fill: #2b1a12; -fx-font-size: 18px; -fx-font-weight: 700;" text="Tienda de artesanias"/>
            <Label style="-fx-text-fill: #2f5a42; -fx-font-size: 13px; -fx-font-weight: 700;" text="Tercer programa"/>
            <Button onAction="#abrirEjercicio3" prefWidth="140.0" style="-fx-background-color: linear-gradient(to right, #2f5a42, #5f7f4d); -fx-background-radius: 8; -fx-text-fill: #fffaf1; -fx-font-weight: 700; -fx-padding: 9 16 9 16;" text="Abrir"/>
        </VBox>
    </HBox>
</VBox>
