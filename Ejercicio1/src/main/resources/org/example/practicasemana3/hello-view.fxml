<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="16.0" style="-fx-background-color: linear-gradient(to bottom right, #e8f6ff, #fff7d6, #e9f7e7); -fx-font-family: 'Segoe UI', Arial;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.practicasemana3.Ejercicio1.HelloController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: linear-gradient(to right, #145374, #168aad, #52b788); -fx-background-radius: 12; -fx-padding: 18 24 18 24; -fx-effect: dropshadow(gaussian, rgba(20, 83, 116, 0.28), 14, 0, 0, 6);">
        <Label text="&#x1F6D2;" style="-fx-background-color: #fff3b0; -fx-background-radius: 36; -fx-text-fill: #145374; -fx-font-size: 34px; -fx-padding: 8 12 8 12;"/>
        <VBox spacing="4.0">
            <Label text="Inventario de pulperia" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: 700;"/>
            <Label fx:id="lblMensaje" text="Registre productos y busque por codigo con ENTER." style="-fx-text-fill: #fff3b0; -fx-font-size: 13px;"/>
        </VBox>
    </HBox>

    <VBox spacing="12.0" style="-fx-background-color: #fffef5; -fx-background-radius: 12; -fx-border-color: #f2c94c; -fx-border-radius: 12; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(20, 83, 116, 0.12), 10, 0, 0, 4);">
        <Label text="Registro de producto" style="-fx-text-fill: #145374; -fx-font-size: 18px; -fx-font-weight: 700;"/>

        <GridPane hgap="12.0" vgap="10.0">
            <Label text="Codigo:" style="-fx-text-fill: #145374; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtCodigo" promptText="P001" prefWidth="220.0" style="-fx-background-color: #f8fcff; -fx-background-radius: 7; -fx-border-color: #168aad; -fx-border-radius: 7; -fx-padding: 8;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Nombre:" style="-fx-text-fill: #145374; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtNombre" promptText="Arroz" prefWidth="220.0" style="-fx-background-color: #f8fcff; -fx-background-radius: 7; -fx-border-color: #168aad; -fx-border-radius: 7; -fx-padding: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Precio:" style="-fx-text-fill: #145374; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtPrecio" promptText="25.50" prefWidth="220.0" style="-fx-background-color: #fffbea; -fx-background-radius: 7; -fx-border-color: #f2c94c; -fx-border-radius: 7; -fx-padding: 8;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Cantidad:" style="-fx-text-fill: #145374; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="txtCantidad" promptText="12" prefWidth="220.0" style="-fx-background-color: #eefaf0; -fx-background-radius: 7; -fx-border-color: #52b788; -fx-border-radius: 7; -fx-padding: 8;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        </GridPane>

        <Button text="Guardar producto" onAction="#guardarProducto" prefWidth="220.0" style="-fx-background-color: linear-gradient(to right, #168aad, #52b788); -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: 700; -fx-padding: 10 16 10 16;"/>
    </VBox>

    <VBox spacing="10.0" style="-fx-background-color: #eef9ff; -fx-background-radius: 12; -fx-border-color: #168aad; -fx-border-radius: 12; -fx-padding: 18;">
        <Label text="Busqueda por codigo" style="-fx-text-fill: #145374; -fx-font-size: 17px; -fx-font-weight: 700;"/>
        <TextField fx:id="txtBuscar" promptText="Escriba el codigo y presione ENTER" onKeyPressed="#buscarProducto" style="-fx-background-color: white; -fx-background-radius: 7; -fx-border-color: #168aad; -fx-border-radius: 7; -fx-padding: 9;"/>
        <Label fx:id="lblResultado" text="Sin busqueda realizada." wrapText="true" style="-fx-text-fill: #1b4332; -fx-font-size: 13px; -fx-font-weight: 700;"/>
    </VBox>

    <VBox spacing="8.0" style="-fx-background-color: #f3fff1; -fx-background-radius: 12; -fx-border-color: #52b788; -fx-border-radius: 12; -fx-padding: 18;">
        <Label text="Listado de inventario" style="-fx-text-fill: #1b4332; -fx-font-size: 17px; -fx-font-weight: 700;"/>
        <TextArea fx:id="txtInventario" text="Sin productos registrados." editable="false" prefRowCount="7" wrapText="true" style="-fx-background-color: white; -fx-border-color: #52b788; -fx-border-radius: 8; -fx-text-fill: #173b5f;"/>
    </VBox>
</VBox>
